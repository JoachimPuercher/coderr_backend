# Copy this file to .env and fill in your own values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=generate key with DRF (readme.md)
DEBUG=True
# DNS from the backend - configured in Frontend
ALLOWED_HOSTS=127.0.0.1,localhost

# Where the frontend runs (MainDomain). Needs scheme and port, no trailing slash.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Docker only: SQLITE_PATH and MEDIA_ROOT are set in docker-compose.yml
# and point into the mounted ./data folder. Leave them unset locally.
